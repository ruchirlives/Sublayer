{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sublayer",
  "version": "0.1.0",
  "identifier": "com.orchflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sublayer — USD Workspace",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "../worker/*.py": "worker/",
      "../scripts/installer-runtimes.ps1": "scripts/installer-runtimes.ps1",
      "../LICENSE": "LICENSE",
      "../LICENSE-EXCEPTION.md": "LICENSE-EXCEPTION.md"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis/installer.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
