#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "World"
{
    def Xform "ReferencedCube" (
        prepend references = @cube.usda@</World>
    )
    {
        double3 xformOp:translate = (-1.6, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "Sphere"
    {
        double radius = 1.2
        double3 xformOp:translate = (1.5, 1.2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.35, 0.55, 0.85)]
    }
    def Cube "Ground"
    {
        double size = 1
        double3 xformOp:translate = (0, -0.1, 0)
        double3 xformOp:scale = (8, 0.2, 6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.22, 0.25, 0.27)]
    }
}
